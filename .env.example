# Скопируйте в .env и заполните: cp .env.example .env

# Пароль базы данных (используйте только буквы и цифры, чтобы не ломать строку подключения)
POSTGRES_PASSWORD=change_me_please
POSTGRES_USER=uchi
POSTGRES_DB=uchi

# Секрет для подписи токенов входа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change_me_with_openssl_rand_hex_32

# Сколько заданий в день ученик решает бесплатно
FREE_DAILY_LIMIT=20

# mock — тестовая «оплата» без денег (только для проверки!)
# Для боевого запуска подключите платёжного провайдера и уберите mock.
PAYMENTS_MODE=mock

# Ваш домен без http:// (DNS-запись A должна вести на IP сервера). HTTPS настроится сам.
DOMAIN=example.com

# Адрес API для веб-сборки. /api — тот же домен через nginx (рекомендуется).
EXPO_PUBLIC_API_URL=/api

# true — схема БД создаётся автоматически (удобно для старта).
# После перехода на миграции поставьте false.
DB_SYNC=true

# Почта для писем (сброс пароля, подтверждение, отчёты родителям). Необязательно.
# Пример для Яндекс: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465, SMTP_USER=ваш_ящик@yandex.ru,
# SMTP_PASS=пароль приложения (создаётся в настройках Яндекс ID), MAIL_FROM=ваш_ящик@yandex.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Уведомления в Telegram, если сайт упал (необязательно): токен бота от @BotFather и ваш chat id.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Если хостинг закрыл почтовые порты: BREVO_API_KEY=ключ из brevo.com (отправка по HTTPS), MAIL_FROM=подтверждённый адрес
BREVO_API_KEY=
